# ==============================================================================
# CHAANBEAN ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your production credentials.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production deployment.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://chaanbean:chaanbean@localhost:5432/chaanbean?schema=public"

# ------------------------------------------------------------------------------
# 2. REDIS / CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# Redis connection string for distributed caching and rate limiting.
# Optional: falls back gracefully to in-memory cache if unconfigured.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
# Canonical public URL of the application
APP_URL="https://chaanbean.com"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY SECRETS (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Master security key required to register new system administrators
ADMIN_SECURITY_KEY="your-strong-random-master-admin-key-here"

# Secret key used for cryptographic session signing (min 32 chars)
SESSION_SECRET="your-32-char-random-session-secret-here"

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY API CREDENTIALS (SERVER-ONLY SECRETS)
# ------------------------------------------------------------------------------

# Ministry of Corporate Affairs (MCA) / Data.gov.in API
MCA_API_KEY=""
DATA_GOV_IN_API_KEY=""

# National API Setu Gateway (GST & Business Data)
APISETU_API_KEY=""

# Statutory Portals
GST_PORTAL_API_KEY=""
IT_PORTAL_API_KEY=""

# Commercial Credit Bureaus
CIBIL_API_KEY=""
EXPERIAN_API_KEY=""
CRIF_API_KEY=""

# Identity Resolution & Verification
FIND_SOMEONE_API_KEY=""
TELECOM_KYC_API_KEY=""

# AWS Infrastructure (Amazon Polly TTS & S3 Evidence Storage)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
POLLY_ACCESS_KEY=""

# Communications & Recovery Channels
SENDGRID_API_KEY=""
WHATSAPP_BSP_API_KEY=""
VOBIZ_SIP_ENDPOINT=""

# AI Decision Engine (Google Gemini)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. PUBLIC / CLIENT-SIDE VARIABLES (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# None currently required. All third-party secrets remain strictly server-side.
