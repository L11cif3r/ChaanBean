# Copy to .env.local and fill in. Never commit real values.

# Supabase (development: project ixhhgevmplfjqkdmpepw, Sydney)
NEXT_PUBLIC_SUPABASE_URL=https://ixhhgevmplfjqkdmpepw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Postgres connection strings (Supabase > Connect > Connection string), with the database password.
# DIRECT_URL = session pooler (port 5432): used by the app and the tests. DATABASE_URL = transaction pooler (port 6543):
# fallback only, because it hangs on bursts of parallel queries (see src/server/db/sql.ts).
DATABASE_URL=
DIRECT_URL=

# Field encryption (PRD section 15). 32 random bytes, base64: openssl rand -base64 32
# Development uses these environment keys; production uses AWS KMS once the Chaanbean AWS account exists.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Signs the cb_sess cookie that enforces the session rules (PRD S01). openssl rand -base64 32
SESSION_COOKIE_SECRET=

# GST search and PAN verification for onboarding (S02): "mock" until a provider is contracted (Part 5)
IDENTITY_PROVIDER=mock

# Protects POST /api/v1/jobs/run (called by pg_cron or another scheduler). openssl rand -hex 24
CRON_SECRET=

# true = run background jobs inside `next dev` (development only)
APP_LOCAL_JOBS=true

# ---------------------------------------------------------------- outside services (docs/PROVIDERS.md)
# Which provider serves each service. Unset = the dummy ("mock"), which needs no keys. A comma list falls back in
# order, e.g. PROVIDER_CW_MSME=zoop,surepass. GET /api/health lists what each service uses and which keys are missing.
# PROVIDER_IDENTITY=          surepass
# PROVIDER_UPI=               surepass | razorpay
# PROVIDER_CW_GST_SEARCH=     surepass | setu
# PROVIDER_CW_GST_TURNOVER_CY= finagg | vayana
# PROVIDER_CW_GST_TURNOVER_4Y= finagg | vayana
# PROVIDER_GSP=               finagg | vayana
# PROVIDER_CW_CIBIL_COMPANY=  cibil | crif | experian
# PROVIDER_CW_CIBIL_PERSONAL= cibil | crif | experian
# PROVIDER_CW_MSME=           zoop | surepass | gridlines
# PROVIDER_CW_PAN=            surepass | cashfree
# PROVIDER_CW_IEC_PROFILE=    surepass | setu
# PROVIDER_CW_IEC_TURNOVER=   volza | eximpedia
# PROVIDER_CW_COMPANY=        probe42 | gridlines
# PROVIDER_CW_DIRECTORS=      probe42 | signzy | gridlines
# PROVIDER_CW_CREDIT_RATING=  probe42
# PROVIDER_CC_COURT=          surepass | legalkart
# PROVIDER_CC_FIR=            authbridge | idfy
# PROVIDER_CC_AML=            signzy | hyperverge
# PROVIDER_OTP=               exotel
# PROVIDER_SMS=               exotel
# PROVIDER_WHATSAPP=          exotel
# PROVIDER_EMAIL=             ses | zeptomail
# PROVIDER_PAYMENTS=          razorpay | cashfree
# PROVIDER_STORAGE=           s3 | gcs        (write-once store for sealed PDFs; unset = database)

# Keys for real providers (PRD v3.0 Appendix B). Production keeps them in the secret store.
SUREPASS_API_TOKEN=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_ASP_ID=
BUREAU_API_KEY=
BUREAU_API_SECRET=
ZOOP_APP_ID=
ZOOP_API_KEY=
PROBE42_API_KEY=
SIGNZY_API_KEY=
VOLZA_API_KEY=
FIR_PROVIDER_API_KEY=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_WHATSAPP_FROM=
EXOTEL_WA_OTP_TEMPLATE=chaanbean_otp
EXOTEL_SMS_SENDER_ID=
EXOTEL_SMS_DLT_ENTITY_ID=
EXOTEL_SMS_OTP_TEMPLATE_ID=
EXOTEL_WEBHOOK_SECRET=
SES_FROM_EMAIL=
AWS_REGION=ap-south-1
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=
EVIDENCE_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EVIDENCE_GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Fallback providers, only if chosen above
GRIDLINES_API_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
EXIMPEDIA_API_KEY=
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
LEGALKART_API_KEY=

# ---------------------------------------------------------------- PRD v4.0 (CW and Case Check changes)
# Sample data mode (section 10): true shows sample results everywhere and never touches the wallet. In mixed mode
# (unset) a check uses its live provider when keys are set and sample data otherwise.
SAMPLE_DATA_MODE=
# Seconds to cancel after "Yes, run search" (section 8, default 3, 1 to 15).
CANCEL_WINDOW_SECONDS=3
# Multiple search limits (section 6.1): file rows (default 50) and typed rows (default 10).
BULK_MAX_ROWS=50
BULK_MAX_TYPED=10
# MCA open data on data.gov.in (section 2.1). Resource ids, comma separated; the first is the RoC-wise master data.
DATA_GOV_IN_API_KEY=
MCA_DATASET_RESOURCE_IDS=4dbe5667-7b6b-41d7-82af-211562424d9a
# API Setu GSTN taxpayer details (PROVIDER_IDENTITY=apisetu, PROVIDER_CW_GST_SEARCH=apisetu). The older APISETU_* names
# work too. The live host is https://apisetu.gov.in (the beta host answered 503 on 20 Oct 2026).
GSTN_CLIENT_ID=
GSTN_API_KEY=
GSTN_BASE_URL=https://apisetu.gov.in
# GST Registration Certificate (GSTN on API Setu, runs on the UAT host): PROVIDER_GST_CERTIFICATE=apisetu once the
# encryption details from API Setu are in. GSTN_ENCRYPTION_ENABLED=true needs GSTN_ENCRYPTION_KEY.
GSTN_RC_BASE_URL=https://beta.api-setu.in
GSTN_ENCRYPTION_ENABLED=
GSTN_ENCRYPTION_KEY=
# MCA open data also accepts MCA_API_KEY (the same data.gov.in key). Company check: PROVIDER_CW_COMPANY=mca.
# Sign-in OTP by SMS through Fast2SMS on DLT (section 11.1, to confirm): PROVIDER_SMS=fast2sms, PROVIDER_OTP=fast2sms,
# then add /api/v1/auth/sms-hook as the Send SMS hook in Supabase Auth with its secret below.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=
SEND_SMS_HOOK_SECRET=
# KYC at sign-up with DigiLocker (section 11.2): PROVIDER_KYC=digilocker once partner access is set up.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
# Ops console (/admin): staff mobiles, comma separated, until staff sign-in with two-factor arrives (Part 10).
OPS_MOBILES=
