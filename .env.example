# Copy to .env.local and fill in. Never commit real values.

# Supabase (development: project ixhhgevmplfjqkdmpepw, Sydney)
NEXT_PUBLIC_SUPABASE_URL=https://ixhhgevmplfjqkdmpepw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Postgres connection strings (Supabase > Connect > Connection string), with the database password.
# DATABASE_URL = transaction pooler (port 6543), used by the app. DIRECT_URL = session pooler (port 5432), used by tests.
DATABASE_URL=
DIRECT_URL=

# Field encryption (PRD section 15). 32 random bytes, base64: openssl rand -base64 32
# Development uses these environment keys; production uses AWS KMS once the Chaanbean AWS account exists.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Protects POST /api/v1/jobs/run (called by pg_cron or another scheduler). openssl rand -hex 24
CRON_SECRET=

# true = run background jobs inside `next dev` (development only)
APP_LOCAL_JOBS=true
