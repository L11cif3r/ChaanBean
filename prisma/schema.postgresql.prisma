  reviewedBy           String?
  reviewNotes          String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company              Company      @relation(fields: [companyId], references: [id])
  recoveryCase         RecoveryCase @relation(fields: [recoveryCaseId], references: [id])

  @@index([companyId])
  @@index([status])
}

