// -------------------------------------------------------------
// LEGAL RECOVERY & ADVISOR INFRASTRUCTURE
// -------------------------------------------------------------

model LegalAdvisor {
  id                String   @id @default(cuid())
  name              String
  firmName          String?
  barCouncilNo      String   @unique
  specialization    String   // MSMED Act Arbitration | Section 138 NI Act | IBC Insolvency | Commercial Recovery
  jurisdiction      String   // e.g. Mumbai, Delhi, Bengaluru, Chennai, All-India
  status            String   @default("verified") // verified | pending | suspended
  contactEmail      String
  phone             String
  activeCasesCount  Int      @default(0)
  successRate       Float    @default(92.0)
  createdAt         DateTime @default(now())

  cases             ArbitrationCase[]
  feeLedgers        LegalFeeLedger[]
}

model LegalEvidencePack {
  id                String   @id @default(cuid())
  creditAccountId   String
  arbitrationCaseId String?
  title             String
  bundleUrl         String?
  documentsList     String   // JSON list of indexed evidence
  status            String   @default("draft") // draft | certified | shared | admitted
  generatedBy       String   @default("Legal Desk")
  certifiedAt       DateTime @default(now())

  creditAccount     CreditAccount    @relation(fields: [creditAccountId], references: [id])
  arbitrationCase   ArbitrationCase? @relation(fields: [arbitrationCaseId], references: [id])

  @@index([creditAccountId])
}

model LegalFeeLedger {
  id                String   @id @default(cuid())
  arbitrationCaseId String
  advisorId         String
  feeType           String   // legal_notice_fee | filing_fee | hearing_fee | success_fee
  amount            Float
  paymentStatus     String   @default("escrowed") // pending | escrowed | disbursed
  transactionRef    String?
  createdAt         DateTime @default(now())

  arbitrationCase   ArbitrationCase @relation(fields: [arbitrationCaseId], references: [id])
  advisor           LegalAdvisor    @relation(fields: [advisorId], references: [id])

  @@index([arbitrationCaseId])
  @@index([advisorId])
}

