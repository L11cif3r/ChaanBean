/// Buyer GSTIN verified by OTP to the primary authorised signatory (API Setu GSTN RC). FKs exist in the DB;
/// relations are left undeclared here so existing models stay untouched.
model gst_verifications {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisation_id        String                     @db.Uuid
  company_check_id       String                     @db.Uuid
  gstin                  String                     @db.VarChar(15)
  legal_name_entered     String
  signatory_email_masked String
  signatory_email_hash   String                     @db.Char(64)
  provider               String
  txn_id                 String?
  status                 cc_gst_verification_status
  otp_attempts           Int                        @default(0) @db.SmallInt
  otp_sent_at            DateTime?                  @db.Timestamptz(6)
  expires_at             DateTime?                  @db.Timestamptz(6)
  verified_at            DateTime?                  @db.Timestamptz(6)
  legal_name             String?
  trade_name             String?
  constitution           String?
  name_matches_company   Boolean?
  certificate_pdf        Bytes?
  certificate_sha256     String?                    @db.Char(64)
  error_code             String?
  initiated_by           String                     @db.Uuid
  created_at             DateTime                   @default(now()) @db.Timestamptz(6)

  @@index([company_check_id, created_at(sort: Desc)])
  @@index([organisation_id, created_at(sort: Desc)])
}
