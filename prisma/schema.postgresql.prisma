  credit_period_days    Int?
  override_reason       String?            @db.VarChar(500)
  notes                 String?            @db.VarChar(1000)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  credit_assessments    credit_assessments @relation(fields: [credit_assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_users             app_users?         @relation(fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organisations         organisations      @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

}

model credit_policies {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version            Int                  @unique
  status             cc_policy_status     @default(DRAFT)
  params             Json
  notes              String?
  created_by         String?              @db.Uuid
  approved_by        String?              @db.Uuid
  activated_at       DateTime?            @db.Timestamptz(6)
  retired_at         DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  credit_assessments credit_assessments[]

}

model directors {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  din               String              @unique @db.Char(8)
  full_name         String
  din_status        String?
  source            String
  fetched_at        DateTime            @db.Timestamptz(6)
  company_directors company_directors[]

}

model gst_return_filings {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gst_registration_id       String                    @db.Uuid
  return_type               cc_gst_return_type
  tax_period                String                    @db.Char(6)
  fiscal_year               String?                   @db.VarChar(7)
  due_date                  DateTime?                 @db.Date
  filed_on                  DateTime?                 @db.Date
  days_late                 Int?                      @default(dbgenerated("GREATEST((filed_on - due_date), 0)"))
  filing_status             cc_filing_status
  source                    String
  fetched_at                DateTime                  @db.Timestamptz(6)
  company_gst_registrations company_gst_registrations @relation(fields: [gst_registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([gst_registration_id, return_type, tax_period])
}

model lookup_prices {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_code     cc_product_code
  price_paise      BigInt
  gst_rate         Decimal         @default(0.18) @db.Decimal(5, 4)
  free_reopen_days Int             @default(30)
  effective_from   DateTime        @default(now()) @db.Timestamptz(6)
  effective_to     DateTime?       @db.Timestamptz(6)

}

model organisation_members {
  organisation_id String         @db.Uuid
  user_id         String         @db.Uuid
  role            cc_member_role
  status          String         @default("ACTIVE")
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organisations   organisations  @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_users       app_users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([organisation_id, user_id])
  @@index([user_id], map: "organisation_members_user_idx")
}

model organisations {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legal_name             String
  gstin                  String?                  @db.VarChar(15)
  kyc_status             cc_kyc_status            @default(PENDING)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  company_check_sections company_check_sections[]
  company_checks         company_checks[]
  credit_assessments     credit_assessments[]
  credit_decisions       credit_decisions[]
  organisation_members   organisation_members[]
  report_files           report_files[]
  subscriptions          subscriptions[]
  wallet_ledger          wallet_ledger[]
  wallets                wallets?

}

model outbox_events {
  id              BigInt    @id @default(autoincrement())
  event_type      String
  organisation_id String?   @db.Uuid
  payload         Json
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  published_at    DateTime? @db.Timestamptz(6)

}

model provider_calls {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_check_id  String?             @db.Uuid
  organisation_id   String?             @db.Uuid
  provider          String
  operation         String
  mode              cc_provider_mode
  request_hash      String?             @db.Char(64)
  http_status       Int?
  outcome           cc_provider_outcome
  latency_ms        Int?
  cost_paise        BigInt              @default(0)
  raw_response_path String?
  correlation_id    String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  company_checks    company_checks?     @relation(fields: [company_check_id], references: [id], onUpdate: NoAction)

  @@index([provider, created_at(sort: Desc)], map: "provider_calls_provider_idx")
}

model report_files {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_check_id     String              @db.Uuid
  credit_assessment_id String?             @db.Uuid
  organisation_id      String              @db.Uuid
  storage_path         String
  sha256               String              @db.Char(64)
  size_bytes           Int?
  version              Int                 @default(1)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  company_checks       company_checks      @relation(fields: [company_check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_assessments   credit_assessments? @relation(fields: [credit_assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organisations        organisations       @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

}

model subscriptions {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisation_id    String                 @db.Uuid
  plan_code          String
  status             cc_subscription_status
  current_period_end DateTime               @db.Timestamptz(6)
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  organisations      organisations          @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organisation_id, current_period_end(sort: Desc)], map: "subscriptions_org_idx")
}

model wallet_ledger {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisation_id     String          @db.Uuid
  entry_type          cc_ledger_entry
  amount_paise        BigInt
  balance_after_paise BigInt
  reference_type      String?
  reference_id        String?         @db.Uuid
  gateway_payment_id  String?         @unique
  created_by          String?         @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  organisations       organisations   @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organisation_id, created_at(sort: Desc)], map: "wallet_ledger_org_idx")
}

model wallets {
  organisation_id String        @id @db.Uuid
  balance_paise   BigInt        @default(0)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organisations   organisations @relation(fields: [organisation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

}

